--TEST--
ClientEncryption: Decimal128 range encryption and range queries (libmongocrypt with Decimal128 support)
--DESCRIPTION--
Local test (not upstream). ext-mongodb's libmongocrypt is built without Decimal128 support and
refuses Decimal128 range values; here they work as in libmongocrypt 1.21 built with it. The
expected output is libmongocrypt 1.21.2's (pymongocrypt, built with Decimal128 support): query
payloads byte for byte, insert payloads in every deterministic field (the random ones by length).
Listed in DIVERGENCES.md.
--SKIPIF--
<?php require __DIR__ . "/../phpt/utils/basic-skipif.inc"; ?>
<?php skip_if_not_live(); ?>
<?php skip_if_server_version('<', '7.0'); ?>
<?php skip_if_not_clean(CSFLE_KEY_VAULT_DATABASE_NAME, CSFLE_KEY_VAULT_COLLECTION_NAME);
--FILE--
<?php
require_once __DIR__ . "/../phpt/utils/basic.inc";
use MongoDB\BSON\{Binary, Decimal128, Document};
$ce = create_test_manager()->createClientEncryption([
    'keyVaultNamespace' => CSFLE_KEY_VAULT_NS,
    'kmsProviders' => ['local' => ['key' => new Binary(str_repeat("\x07", 96), 0)]],
]);
$kid = $ce->createDataKey('local', ['keyMaterial' => new Binary(str_repeat("\x2a", 96), 0)]);
// the same normalisation as dec.py (json.dumps style)
function f($x) {
    if (is_array($x)) { $o = []; foreach ($x as $k => $v) { $o[$k] = ((string) $k === 'p' || (string) $k === 'v') && $v instanceof Binary ? 'len' . strlen($v->getData()) : f($v); } return $o; }
    if ($x instanceof Binary) return bin2hex($x->getData());
    if ($x instanceof Decimal128) return 'D' . $x;
    if ($x instanceof MongoDB\BSON\Int64) return (int) (string) $x;
    return $x;
}
function norm($bin) {
    $b = $bin->getData(); $s = ord($b[0]);
    if ($s !== 11 && $s !== 13) return "sub$s " . bin2hex($b);
    $d = Document::fromBSON(substr($b, 1))->toPHP(['root' => 'array', 'document' => 'array', 'array' => 'array']);
    $j = json_encode(f($d), JSON_UNESCAPED_SLASHES | JSON_PRESERVE_ZERO_FRACTION);
    return "sub$s " . str_replace([':', ','], [': ', ', '], $j);
}
foreach (json_decode('[{"name": "noprec-q", "opts": {"sparsity": 1}, "q": ["-3.5", true, "1E+3", false]}, {"name": "noprec-q2", "opts": {"sparsity": 2, "trimFactor": 3}, "q": ["0", true, "0.0001", true]}, {"name": "noprec-q3", "opts": {"sparsity": 1}, "q": ["-1E-6176", true, "9999999999999999999999999999999999E6111", true]}, {"name": "prec-q", "opts": {"min": "-100", "max": "100", "precision": 2, "sparsity": 1}, "q": ["-1.5", true, "3.14", false]}, {"name": "prec-q2", "opts": {"min": "0.001", "max": "999.999", "precision": 3, "sparsity": 2, "trimFactor": 2}, "q": ["1.0005", true, "500", true]}, {"name": "prec-q3", "opts": {"min": "-1E+20", "max": "1E+20", "precision": 5, "sparsity": 3}, "q": ["-12345678901234.56789", false, "98765432109876543.21", true]}, {"name": "noprec-i", "opts": {"sparsity": 1}, "v": "3.14159"}, {"name": "noprec-i-neg", "opts": {"sparsity": 2}, "v": "-2.5E-10"}, {"name": "noprec-i-zero", "opts": {"sparsity": 1}, "v": "0E+5"}, {"name": "prec-i", "opts": {"min": "-100", "max": "100", "precision": 2, "sparsity": 1}, "v": "31.4159"}, {"name": "prec-i2", "opts": {"min": "0.001", "max": "999.999", "precision": 3, "sparsity": 2, "trimFactor": 1}, "v": "1.0005"}]', true) as $c) {
    $o = $c['opts']; $ro = ['sparsity' => $o['sparsity']];
    foreach (['min', 'max'] as $k) if (isset($o[$k])) $ro[$k] = new Decimal128($o[$k]);
    if (isset($o['precision'])) $ro['precision'] = $o['precision'];
    if (isset($o['trimFactor'])) $ro['trimFactor'] = $o['trimFactor'];
    $opts = ['keyId' => $kid, 'algorithm' => 'Range', 'contentionFactor' => 0, 'rangeOpts' => $ro];
    try {
        if (isset($c['q'])) {
            [$lo, $li, $hi, $hinc] = $c['q'];
            $expr = ['$and' => [['v' => [($li ? '$gte' : '$gt') => new Decimal128($lo)]], ['v' => [($hinc ? '$lte' : '$lt') => new Decimal128($hi)]]]];
            $r = $ce->encryptExpression($expr, $opts + ['queryType' => 'range']);
            $out = [];
            foreach ($r->{'$and'} as $cond) foreach ($cond->v as $op => $v) $out[] = "$op " . norm($v);
            echo $c['name'], ' ', implode(' | ', $out), "\n";
        } else {
            $r = norm($ce->encrypt(new Decimal128($c['v']), $opts)); echo $c['name'], ' ', str_replace(bin2hex($kid->getData()), 'KEYID', $r), "\n";
        }
    } catch (Throwable $e) { echo $c['name'], ' E ', $e->getMessage(), "\n"; }
}
?>
===DONE===
